        "@passui/tanstack": "workspace:*",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-router": "^1.170.39",
        "@tanstack/react-start": "^1.168.58",
        "motion": "13.5.0",
        "prettier": "3.9.9",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "shiki": "^4.5.0",
        "solid-js": "1.9.17",
        "tailwindcss": "^4.3.3",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.60.2",
        "@rolldown/plugin-babel": "^0.2.4",
