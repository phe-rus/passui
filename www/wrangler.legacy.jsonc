{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "hino",
    "main": "legacy-redirect.ts",
    "compatibility_date": "2026-08-08",
    "compatibility_flags": ["nodejs_compat"],
    "workers_dev": false,
    "preview_urls": false,
    "observability": {
        "enabled": true,
        "traces": { "enabled": true }
    },
    "vars": { "NODE_ENV": "production" },
    "routes": [
        {
            "custom_domain": true,
            "pattern": "hino.pherus.org"
        }
    ]
}
