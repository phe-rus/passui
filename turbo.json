{
    "$schema": "https://turbo.build/schema.json",
    "ui": "tui",
    "tasks": {
        "dev": {
            "cache": false,
            "persistent": true
        },
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**"]
        },
        "typecheck": {
            "dependsOn": ["^typecheck"]
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "format": {
            "cache": false
        },
        "check": {
            "dependsOn": ["lint", "format"]
        },
        "test": {
            "dependsOn": ["^build"]
        },
        "publish:check": {
            "dependsOn": ["^publish:check"]
        },
        "@passui/tokens#build": {
            "outputs": ["theme.css"]
        },
        "@passui/react#build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/types/**"]
        },
        "@passui/react#typecheck": {
            "dependsOn": ["build", "^typecheck"]
        },
        "@passui/solid#build": {
            "dependsOn": ["^build"],
            "outputs": []
        },
        "@passui/solid#typecheck": {
            "dependsOn": ["build", "^typecheck"]
        },
        "@passui/tanstack#build": {
            "dependsOn": ["^build"],
            "outputs": []
        },
        "passui#typecheck": {
            "dependsOn": ["build", "^typecheck"]
        }
    }
}
