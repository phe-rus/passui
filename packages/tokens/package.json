{
	"name": "@passui/tokens",
	"version": "0.1.5",
	"description": "Framework independent Passui design tokens and shared styles.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/phe-rus/passui.git",
		"directory": "packages/tokens"
	},
	"homepage": "https://passui.pherus.org",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"files": [
		"dist",
		"styles",
		"theme.css",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": "./dist/index.js",
		"./accent": "./dist/accent.js",
		"./color": "./dist/color.js",
		"./layout": "./dist/layout.js",
		"./motion": "./dist/motion.js",
		"./theme-css": "./dist/theme-css.js",
		"./typography": "./dist/typography.js",
		"./package.json": "./package.json",
		"./theme.css": "./theme.css",
		"./base.css": "./styles/base.css",
		"./utilities.css": "./styles/utilities.css",
		"./typeset.css": "./styles/typeset.css",
		"./styles.css": "./styles/styles.css"
	},
	"scripts": {
		"generate": "bun scripts/generate-css.ts",
		"build": "bun run generate && tsdown",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"publish:check": "bun pm pack --dry-run"
	},
	"dependencies": {
		"tw-animate-css": "^1.4.0"
	},
	"peerDependencies": {
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"typescript": "catalog:",
		"@types/node": "catalog:",
		"tailwindcss": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"tsdown": "catalog:"
	},
	"sideEffects": [
		"**/*.css"
	]
}
