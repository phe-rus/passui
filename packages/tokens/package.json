{
    "name": "@passui/tokens",
    "version": "0.1.1",
    "description": "Framework independent Passui design tokens and shared styles.",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/phe-rus/passui.git",
        "directory": "packages/tokens"
    },
    "homepage": "https://passui.pherus.org",
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "files": [
        "src",
        "styles",
        "theme.css",
        "README.md",
        "LICENSE"
    ],
    "exports": {
        ".": "./src/index.ts",
        "./theme.css": "./theme.css",
        "./base.css": "./styles/base.css",
        "./utilities.css": "./styles/utilities.css",
        "./typeset.css": "./styles/typeset.css",
        "./styles.css": "./styles/styles.css",
        "./accent": "./src/accent.ts",
        "./color": "./src/color.ts",
        "./layout": "./src/layout.ts",
        "./motion": "./src/motion.ts",
        "./theme-css": "./src/theme-css.ts",
        "./typography": "./src/typography.ts"
    },
    "scripts": {
        "generate": "bun scripts/generate-css.ts",
        "build": "bun run generate",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "publish:check": "bun pm pack --dry-run"
    },
    "dependencies": {
        "tw-animate-css": "^1.4.0"
    },
    "peerDependencies": {
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "typescript": "^7.0.2",
        "@types/node": "^26.6.3",
        "tailwindcss": "^4.3.3",
        "vite": "8.3.5",
        "vitest": "5.0.5"
    }
}
