{
    "name": "@passui/cli",
    "version": "0.2.1",
    "description": "Set up Passui in React and SolidJS projects and create Vite or TanStack Start starters.",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/phe-rus/passui.git",
        "directory": "packages/cli"
    },
    "homepage": "https://passui.pherus.org/docs/installation",
    "bin": {
        "passui": "dist/passui.js"
    },
    "files": [
        "dist/passui.js",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=22.12.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "scripts": {
        "build": "bun build src/index.ts --target=node --outfile=dist/passui.js && chmod +x dist/passui.js",
        "typecheck": "tsc --noEmit",
        "test": "bun run build && vitest run",
        "prepack": "bun run build",
        "publish:check": "bun pm pack --dry-run"
    },
    "devDependencies": {
        "@types/node": "^26.6.3",
        "typescript": "^7.0.2",
        "vitest": "5.0.5",
        "vite": "8.3.5",
        "oxc-parser": "0.155.0"
    }
}
