{
    "name": "@passui/solid",
    "private": true,
    "version": "0.1.0",
    "description": "Passui: native SolidJS controls, design tokens, presentation and appearance.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/phe-rus/passui.git",
        "directory": "packages/solid"
    },
    "homepage": "https://passui.pherus.org",
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    },
    "files": [
        "src",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "exports": {
        "./appearance": "./src/appearance/index.ts",
        "./cn": "./src/lib/class-names.ts",
        ".": "./src/index.ts",
        "./styles.css": "./src/styles/styles.css",
        "./base.css": "./src/styles/base.css",
        "./utilities.css": "./src/styles/utilities.css",
        "./typeset.css": "./src/styles/typeset.css",
        "./theme.css": "./src/styles/theme.css",
        "./tokens": "./src/tokens/index.ts"
    },
    "scripts": {
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json",
        "publish:check": "bun pm pack --dry-run",
        "build": "tsc --noEmit"
    },
    "packageManager": "bun@1.4.2",
    "peerDependencies": {
        "solid-js": "^1.9.0",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@types/node": "^26.6.3",
        "solid-js": "^1.9.5",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vitest": "5.0.5",
        "vite": "8.3.5"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "tailwind-merge": "^3.7.0",
        "@passui/tokens": "workspace:^"
    }
}
