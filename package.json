{
	"name": "passui-repository",
	"private": true,
	"type": "module",
	"license": "MIT",
	"packageManager": "bun@1.4.2",
	"workspaces": [
		"packages/*",
		"www"
	],
	"scripts": {
		"docs:api": "bun scripts/generate-docs.mjs",
		"dev": "turbo run dev",
		"build": "turbo run build",
		"typecheck": "turbo run typecheck",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check . && turbo run typecheck",
		"test": "turbo run test",
		"publish:check": "turbo run publish:check",
		"build:website": "turbo run build --filter=passui",
		"format:check": "biome format .",
		"size:check": "turbo run build --filter=@passui/react && bun scripts/measure-react.mjs --check"
	},
	"devDependencies": {
		"@babel/parser": "7.29.9",
		"@biomejs/biome": "catalog:",
		"tsdown": "catalog:",
		"turbo": "2.11.10",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"catalog": {
		"@biomejs/biome": "2.6.3",
		"@types/node": "^26.6.6",
		"@playwright/test": "1.65.0",
		"@zag-js/dialog": "1.47.0",
		"@zag-js/drawer": "1.47.0",
		"@zag-js/menu": "1.47.0",
		"@zag-js/popover": "1.47.0",
		"@zag-js/tooltip": "1.47.0",
		"@zag-js/react": "1.47.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@hugeicons/core-free-icons": "4.4.0",
		"@hugeicons/react": "1.1.10",
		"motion": "14.12.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwindcss": "^4.3.5",
		"tsdown": "0.23.7",
		"typescript": "^7.0.2",
		"vite": "8.3.8",
		"vitest": "5.1.0"
	}
}
