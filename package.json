{
	"name": "passui-repository",
	"private": true,
	"type": "module",
	"license": "MIT",
	"packageManager": "bun@1.4.2",
	"workspaces": [
		"packages/*",
		"www"
	],
	"scripts": {
		"docs:api": "bun run --cwd www docs:api",
		"dev": "turbo run dev",
		"build": "turbo run build",
		"typecheck": "turbo run typecheck",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check . && turbo run typecheck",
		"test": "turbo run test",
		"publish:check": "turbo run publish:check",
		"build:website": "turbo run build --filter=passui",
		"format:check": "biome format .",
		"size:check": "turbo run build --filter=@passui/react && bun scripts/measure-react.mjs --check"
	},
	"devDependencies": {
		"@babel/parser": "7.29.9",
		"@biomejs/biome": "catalog:",
		"tsdown": "catalog:",
		"turbo": "2.11.10",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"catalog": {
		"@biomejs/biome": "2.6.3",
		"@playwright/test": "1.65.0",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@zag-js/accordion": "1.47.0",
		"@zag-js/avatar": "1.47.0",
		"@zag-js/checkbox": "1.47.0",
		"@zag-js/collapsible": "1.47.0",
		"@zag-js/combobox": "1.47.0",
		"@zag-js/dialog": "1.47.0",
		"@zag-js/drawer": "1.47.0",
		"@zag-js/menu": "1.47.0",
		"@zag-js/pagination": "1.47.0",
		"@zag-js/pin-input": "1.47.0",
		"@zag-js/popover": "1.47.0",
		"@zag-js/progress": "1.47.0",
		"@zag-js/radio-group": "1.47.0",
		"@zag-js/react": "1.47.0",
		"@zag-js/select": "1.47.0",
		"@zag-js/slider": "1.47.0",
		"@zag-js/switch": "1.47.0",
		"@zag-js/tabs": "1.47.0",
		"@zag-js/toast": "1.47.0",
		"@zag-js/toggle-group": "1.47.0",
		"@zag-js/tooltip": "1.47.0",
		"motion": "14.12.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwindcss": "^4.3.5",
		"tsdown": "0.23.7",
		"typescript": "^7.0.2",
		"vite": "8.3.8",
		"vitest": "5.1.0"
	}
}
